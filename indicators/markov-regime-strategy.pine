//@version=6
strategy("Markov Chain Regime Strategy", overlay=true, initial_capital=100000,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     pyramiding=0)

// === Inputs ===
lookback       = input.int(250,   "Effective Transition Window", minval=20)
emaLen         = input.int(50,    "Trend EMA Length")
rsiLen         = input.int(14,    "RSI Length")
rsiHigh        = input.float(60,  "RSI Bull Threshold")
rsiLow         = input.float(40,  "RSI Bear Threshold")
atrLen         = input.int(14,    "ATR Length")
atrStopMult    = input.float(2.0, "ATR Stop Multiplier", step=0.1)
riskReward     = input.float(2.0, "Risk / Reward", step=0.1)
riskPct        = input.float(1.0, "Risk per Trade %", step=0.1, minval=0.01) / 100.0
maxExposurePct = input.float(100, "Max Position Exposure %", step=5, minval=1) / 100.0
changeThresh   = input.float(0.45, "Regime-Change Probability Threshold", step=0.01, tooltip="Fires when P(next state = target) from the current row exceeds this value.")
minSamples     = input.int(20,    "Minimum Row Samples", minval=1)
laplaceAlpha   = input.float(1.0, "Laplace Smoothing α", step=0.5, minval=0)
exitOnFlip     = input.bool(true, "Exit on Regime Flip")
allowLongs     = input.bool(true, "Allow Long Trades")
allowShorts    = input.bool(false, "Allow Short Trades")
showTable      = input.bool(true, "Show Probability Table")

// === Indicators ===
ema = ta.ema(close, emaLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

// === State Classification: 0=Bull, 1=Neutral, 2=Bear ===
state = close > ema and rsi > rsiHigh ? 0 :
     close < ema and rsi < rsiLow  ? 2 :
     1

stateName(s) =>
    s == 0 ? "Bull" : s == 1 ? "Neutral" : s == 2 ? "Bear" : "n/a"

// === Exponentially-weighted transition matrix (confirmed bars only) ===
decay = 1.0 - 1.0 / lookback

var float bullToBull    = 0.0
var float bullToNeutral = 0.0
var float bullToBear    = 0.0
var float neuToBull     = 0.0
var float neuToNeutral  = 0.0
var float neuToBear     = 0.0
var float bearToBull    = 0.0
var float bearToNeutral = 0.0
var float bearToBear    = 0.0

bullToBull    *= decay
bullToNeutral *= decay
bullToBear    *= decay
neuToBull     *= decay
neuToNeutral  *= decay
neuToBear     *= decay
bearToBull    *= decay
bearToNeutral *= decay
bearToBear    *= decay

prev = state[2]
nxt  = state[1]
if not na(prev) and not na(nxt)
    if prev == 0
        if nxt == 0
            bullToBull += 1
        else if nxt == 1
            bullToNeutral += 1
        else
            bullToBear += 1
    else if prev == 1
        if nxt == 0
            neuToBull += 1
        else if nxt == 1
            neuToNeutral += 1
        else
            neuToBear += 1
    else
        if nxt == 0
            bearToBull += 1
        else if nxt == 1
            bearToNeutral += 1
        else
            bearToBear += 1

// === Row totals ===
bullTotal = bullToBull + bullToNeutral + bullToBear
neuTotal  = neuToBull  + neuToNeutral  + neuToBear
bearTotal = bearToBull + bearToNeutral + bearToBear

a3 = 3 * laplaceAlpha

safeProb(cnt, total) =>
    total + a3 > 0 ? (cnt + laplaceAlpha) / (total + a3) : na

pBB = safeProb(bullToBull,    bullTotal)
pBN = safeProb(bullToNeutral, bullTotal)
pBX = safeProb(bullToBear,    bullTotal)
pNB = safeProb(neuToBull,     neuTotal)
pNN = safeProb(neuToNeutral,  neuTotal)
pNX = safeProb(neuToBear,     neuTotal)
pXB = safeProb(bearToBull,    bearTotal)
pXN = safeProb(bearToNeutral, bearTotal)
pXX = safeProb(bearToBear,    bearTotal)

probBull    = state == 0 ? pBB : state == 1 ? pNB : pXB
probNeutral = state == 0 ? pBN : state == 1 ? pNN : pXN
probBear    = state == 0 ? pBX : state == 1 ? pNX : pXX

rowTotal   = state == 0 ? bullTotal : state == 1 ? neuTotal : bearTotal
sufficient = rowTotal >= minSamples

// === Regime-change signals ===
leanBullProb = state == 1 ? pNB : state == 2 ? pXB : 0.0
leanBearProb = state == 1 ? pNX : state == 0 ? pBX : 0.0

longSignal  = allowLongs  and sufficient and state != 0 and leanBullProb > changeThresh and leanBullProb > leanBearProb and barstate.isconfirmed
shortSignal = allowShorts and sufficient and state != 2 and leanBearProb > changeThresh and leanBearProb > leanBullProb and barstate.isconfirmed

// === Risk-based sizing with exposure cap ===
stopDist = atr * atrStopMult
riskQty  = stopDist > 0 ? (strategy.equity * riskPct) / stopDist : 0.0
maxQty   = close > 0 ? (strategy.equity * maxExposurePct) / close : 0.0
qty      = math.min(riskQty, maxQty)

// === Stop / TP snapshots ===
var float longStopFix   = na
var float longLimitFix  = na
var float shortStopFix  = na
var float shortLimitFix = na

newLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0
newShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
flatNow  = strategy.position_size == 0

// Clear stale snapshots while flat (runs before provisional set so order is safe)
if flatNow
    longStopFix   := na
    longLimitFix  := na
    shortStopFix  := na
    shortLimitFix := na

// Entries: queue order AND set provisional stop using signal-bar close so the
// entry bar is protected even before the fill is confirmed.
if longSignal and strategy.position_size == 0 and qty > 0
    longStopFix  := close - stopDist
    longLimitFix := close + stopDist * riskReward
    strategy.entry("Long", strategy.long, qty=qty)

if shortSignal and strategy.position_size == 0 and qty > 0
    shortStopFix  := close + stopDist
    shortLimitFix := close - stopDist * riskReward
    strategy.entry("Short", strategy.short, qty=qty)

// Refine to actual fill price once known. Use signal-bar ATR (stopDist[1]) so
// realized risk stays consistent with the sizing computed at signal time.
if newLong
    longStopFix  := strategy.position_avg_price - stopDist[1]
    longLimitFix := strategy.position_avg_price + stopDist[1] * riskReward

if newShort
    shortStopFix  := strategy.position_avg_price + stopDist[1]
    shortLimitFix := strategy.position_avg_price - stopDist[1] * riskReward

strategy.exit("Long Exit",  from_entry="Long",  stop=longStopFix,  limit=longLimitFix)
strategy.exit("Short Exit", from_entry="Short", stop=shortStopFix, limit=shortLimitFix)

// Regime-flip exits
if exitOnFlip and strategy.position_size > 0 and state == 2
    strategy.close("Long", comment="Bear Flip")
if exitOnFlip and strategy.position_size < 0 and state == 0
    strategy.close("Short", comment="Bull Flip")

// === Visuals ===
plot(ema, "EMA", color=color.orange)

bgcolor(state == 0 ? color.new(color.green, 88) :
       state == 2 ? color.new(color.red, 88) :
       color.new(color.gray, 92))

plotshape(longSignal,  title="Long Signal",  style=shape.triangleup,
     location=location.belowbar, color=color.green, size=size.small, text="Long")
plotshape(shortSignal, title="Short Signal", style=shape.triangledown,
     location=location.abovebar, color=color.red,   size=size.small, text="Short")

alertcondition(longSignal,  "Markov Long Signal",  "Markov model generated a long signal.")
alertcondition(shortSignal, "Markov Short Signal", "Markov model generated a short signal.")

// === Table ===
fmt(x) =>
    na(x) ? "n/a" : str.tostring(x * 100, "#.##") + "%"

var table t = table.new(position.top_right, 4, 4, border_width=1)

if barstate.islast and showTable
    table.cell(t, 0, 0, "Current State", bgcolor=color.black, text_color=color.white)
    table.cell(t, 1, 0, stateName(state), bgcolor=color.black, text_color=color.white)
    table.cell(t, 2, 0, "Row Samples", bgcolor=color.black, text_color=color.white)
    table.cell(t, 3, 0, str.tostring(rowTotal, "#.#"), bgcolor=color.black, text_color=color.white)

    table.cell(t, 0, 1, "Bull Prob", bgcolor=color.black, text_color=color.white)
    table.cell(t, 1, 1, fmt(probBull), bgcolor=color.black, text_color=color.white)
    table.cell(t, 2, 1, "Bear Prob", bgcolor=color.black, text_color=color.white)
    table.cell(t, 3, 1, fmt(probBear), bgcolor=color.black, text_color=color.white)

    table.cell(t, 0, 2, "ATR Stop", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 1, 2, str.tostring(atrStopMult, "#.##") + "x")
    table.cell(t, 2, 2, "R:R")
    table.cell(t, 3, 2, str.tostring(riskReward, "#.##"))

    table.cell(t, 0, 3, "Risk / Trade", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 1, 3, str.tostring(riskPct * 100, "#.##") + "%")
    table.cell(t, 2, 3, "Max Exposure")
    table.cell(t, 3, 3, str.tostring(maxExposurePct * 100, "#.#") + "%")
